<resources>
    <!-- Default screen margins, per the Android Design guidelines. -->
    <dimen name="activity_horizontal_margin">16dp</dimen>
    <dimen name="activity_vertical_margin">16dp</dimen>

    <!-- Common spacing -->
    <dimen name="spacing_small">4dp</dimen>
    <dimen name="spacing_medium">8dp</dimen>
    <dimen name="spacing_large">16dp</dimen>
    <dimen name="spacing_xlarge">24dp</dimen>
    <dimen name="spacing_xxlarge">32dp</dimen>

    <!-- Font sizes -->
    <dimen name="font_size_small">12sp</dimen>
    <dimen name="font_size_medium">14sp</dimen>
    <dimen name="font_size_large">16sp</dimen>
    <dimen name="font_size_xlarge">18sp</dimen>
    <dimen name="font_size_title">20sp</dimen>
    <dimen name="font_size_headline">24sp</dimen>

    <!-- Video item specific -->
    <dimen name="video_item_thumbnail_width">120dp</dimen>
    <dimen name="video_item_thumbnail_height">90dp</dimen>
    <dimen name="video_item_padding">@dimen/spacing_medium</dimen>
    <dimen name="video_item_text_spacing">@dimen/spacing_small</dimen>

    <!-- Player controls -->
    <dimen name="player_control_button_size">48dp</dimen>
    <dimen name="player_control_padding">@dimen/spacing_medium</dimen>

    <!-- Elevation for cards or other components -->
    <dimen name="card_elevation">2dp</dimen>
    <dimen name="app_bar_elevation">4dp</dimen>

</resources>
